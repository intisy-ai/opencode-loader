{
  "name": "opencode-loader",
  "version": "1.12.0",
  "description": "TUI launcher and oc shell command for OpenCode.",
  "main": "dist/plugin.js",
  "type": "module",
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intisy-ai/opencode-loader.git"
  },
  "keywords": [
    "opencode",
    "plugin",
    "launcher",
    "tui"
  ],
  "files": [
    "dist/",
    "cairn.json",
    "icon.svg",
    "core-loader/dist/",
    "core-loader/api/dist/",
    "core-loader/api/package.json",
    "core/dist/",
    "opencode-proxy/dist/",
    "opencode-proxy/core-proxy/dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm --prefix opencode-proxy install && npm --prefix opencode-proxy run build && npm --prefix core-loader install && npm --prefix core-loader run build && npm --prefix core install && npm --prefix core run build && npm --prefix core-auth install && npm --prefix core-auth run build && npx tsc && node build.mjs",
    "postbuild": "node dist/plugin.js readme",
    "prepublishOnly": "npm run build",
    "test": "npm run build && vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@intisy-ai/core": "file:core",
    "@intisy-ai/core-auth": "file:core-auth",
    "@intisy-ai/core-loader": "file:core-loader",
    "@intisy-ai/opencode-proxy": "file:opencode-proxy",
    "@intisy-ai/api": "file:core-loader/api"
  }
}
